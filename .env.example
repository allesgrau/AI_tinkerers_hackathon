# ============ DATABASE ============
DB_PATH=hospital_agent.db

# ============ GEMINI LIVE ============
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Zephyr
GEMINI_ENABLE_INPUT_AUDIO_TRANSCRIPTION=false
GEMINI_ENABLE_OUTPUT_AUDIO_TRANSCRIPTION=false

# ============ TWILIO (SMS Provider) ============
# Get these from: https://www.twilio.com/console
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
PUBLIC_BASE_URL=https://your-public-ngrok-or-cloudflare-url

# ============ VAPI (Voice Agent Platform) ============
# Get this from: https://vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER=+48123456789

# ============ VOICE VERIFICATION (SpeechBrain - runs offline) ============
# Model: speechbrain/spkrec-ecapa-voxceleb (auto-downloads on first use)
VOICE_SIMILARITY_THRESHOLD=0.72

# ============ AUDIO BUFFER ============
AUDIO_BUFFER_DIR=audio_buffer

# ============ LOG LEVEL ============
LOG_LEVEL=INFO
